{
  "openapi": "3.1.0",
  "info": {
    "title": "Fluss Ctrl API",
    "version": "1.0.0",
    "description": "Hardware-agnostic access control for gates, booms and doors: status, trigger, share, revoke and logs. Errors are RFC 9457 problem details whose `code` is the contract (https://docs.flussctrl.com/errors/). Lists are cursor-paginated.",
    "contact": {
      "name": "Fluss Ctrl",
      "url": "https://docs.flussctrl.com"
    }
  },
  "servers": [
    {
      "url": "https://api.flussctrl.com/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Meta",
      "description": "Service health and metadata."
    }
  ],
  "components": {
    "headers": {
      "X-Request-Id": {
        "description": "Generated by the API for every request (`req_` + UUIDv7); a value sent by the caller is ignored. Quote it when reporting a problem.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      }
    },
    "responses": {
      "Unauthorised": {
        "description": "`401 unauthorised`: Unauthorised.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InsufficientScope": {
        "description": "`403 insufficient_scope`: Insufficient scope.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotFound": {
        "description": "`404 not_found`: Not found.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "`422 validation_failed`: Validation failed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "RateLimited": {
        "description": "`429 rate_limited`: Rate limited.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          },
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InternalError": {
        "description": "`500 internal_error`: Internal error.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "`503 service_unavailable`: Service unavailable.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "OrganisationId": {
        "type": "string",
        "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `org_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "org_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "SiteId": {
        "type": "string",
        "pattern": "^site_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `site_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "site_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "ControllerId": {
        "type": "string",
        "pattern": "^ctl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `ctl_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "ctl_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "DeviceId": {
        "type": "string",
        "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `dev_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "dev_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "DeviceGroupId": {
        "type": "string",
        "pattern": "^grp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `grp_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "grp_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "SubjectId": {
        "type": "string",
        "pattern": "^sub_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `sub_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "sub_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "GrantId": {
        "type": "string",
        "pattern": "^grt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `grt_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "grt_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "CommandId": {
        "type": "string",
        "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `cmd_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "cmd_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "EventId": {
        "type": "string",
        "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `evt_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "evt_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "WebhookEndpointId": {
        "type": "string",
        "pattern": "^whk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `whk_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "whk_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "ClientId": {
        "type": "string",
        "pattern": "^cli_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `cli_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "cli_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "RequestId": {
        "type": "string",
        "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "An id with the `req_` prefix, followed by a lower-case UUIDv7, so ids sort by creation time.",
        "examples": [
          "req_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthorised",
          "insufficient_scope",
          "not_found",
          "validation_failed",
          "rate_limited",
          "internal_error",
          "service_unavailable",
          "idempotency_key_reused",
          "idempotency_in_progress",
          "controller_already_claimed",
          "grant_type_unsupported",
          "delegation_not_allowed",
          "grant_invalid",
          "grant_exhausted",
          "device_offline",
          "command_rate_limited",
          "action_unsupported",
          "provider_disabled",
          "provider_unavailable"
        ],
        "description": "Stable error code. Codes are the API contract and are only ever added; `title` and `detail` wording is not."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "The code's documentation page: `https://docs.flussctrl.com/errors/<code>`."
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary of the code. Not contract."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "The HTTP status, repeated."
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string",
            "description": "What went wrong in this case. Not contract."
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "additionalProperties": {},
        "description": "RFC 9457 problem details. Extension members, such as `command_id` on a recorded command rejection (SPEC §7.3), may be present.",
        "examples": [
          {
            "type": "https://docs.flussctrl.com/errors/not_found",
            "title": "Not found",
            "status": 404,
            "code": "not_found",
            "request_id": "req_01934f6e-7b1a-7c3d-8e9f-0a1b2c3d4e5f"
          }
        ]
      },
      "NextCursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Cursor for the next page, or `null` on the last page. Opaque: do not parse it."
      },
      "Limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50,
        "description": "Page size, 1 to 200. Defaults to 50."
      },
      "Cursor": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque cursor from the previous page's `next_cursor`. Omit it for the first page."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "description": "Shallow liveness: the Worker is up and its configuration is valid. It does not check the database or providers.",
        "examples": [
          {
            "status": "ok"
          }
        ]
      }
    },
    "parameters": {
      "Limit": {
        "schema": {
          "$ref": "#/components/schemas/Limit"
        },
        "required": false,
        "description": "Page size, 1 to 200. Defaults to 50.",
        "name": "limit",
        "in": "query"
      },
      "Cursor": {
        "schema": {
          "$ref": "#/components/schemas/Cursor"
        },
        "required": false,
        "description": "Opaque cursor from the previous page's `next_cursor`. Omit it for the first page.",
        "name": "cursor",
        "in": "query"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Meta"
        ],
        "summary": "Liveness check",
        "description": "Shallow liveness check. Needs no authentication. Answers `200` once the Worker is up with a valid configuration; on a bad configuration nothing is served, this included, and the answer is `500 internal_error`.",
        "security": [],
        "responses": {
          "200": {
            "description": "The Worker is up and its configuration is valid.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "webhooks": {}
}
